{
  "manifest_version": 3,
  "name": "MRU Tab Switcher",
  "version": "0.1.0",
  "description": "Most-recently-used tab switcher: hold Ctrl, tap Tab to cycle, release to switch.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "favicon",
    "offscreen",
    "clipboardWrite",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "cycle-next": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "MacCtrl+Q"
      },
      "description": "Next most-recently-used tab"
    },
    "cycle-prev": {
      "suggested_key": {
        "default": "Alt+Shift+Q",
        "mac": "MacCtrl+Shift+Q"
      },
      "description": "Previous most-recently-used tab"
    },
    "copy-url": {
      "suggested_key": {
        "default": "Ctrl+Shift+C",
        "mac": "Command+Shift+C"
      },
      "description": "Copy current tab's URL"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "ui.js",
        "overlay.js",
        "links.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "_favicon/*"
      ],
      "matches": [
        "<all_urls>"
      ],
      "extension_ids": [
        "*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
